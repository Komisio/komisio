{
  "name": "komisio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "format": "prettier --write app components lib extensions mcp messages tests scripts *.ts *.mjs *.json",
    "format:check": "prettier --check app components lib extensions mcp messages tests scripts *.ts *.mjs *.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:assistance": "node scripts/test-assistance.mjs",
    "test:mcp": "node scripts/test-mcp.mjs",
    "mcp": "node --import tsx mcp/stdio.ts",
    "test:db": "node scripts/supabase.mjs test db",
    "db:start": "node scripts/prepare-local.mjs && node scripts/supabase.mjs start",
    "db:migrate": "node scripts/supabase.mjs migration up --local",
    "test:concurrency": "node scripts/owner-race.mjs",
    "backup:exercise": "node scripts/backup-exercise.mjs",
    "test:seller-photos": "node --import tsx scripts/test-seller-photos.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.0.0",
    "tsx": "4.23.13",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "pg": "^8.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "vitest": "5.0.0"
  }
}
