NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Only needed for the database concurrency test; never exposed to the browser.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted test deployment only; do not copy TEST_DATABASE_URL to Vercel.
KOMISIO_ENVIRONMENT=staging
# Optional pilot invitation transport. Supabase Auth SMTP is configured separately.
INVITATION_EMAIL_DELIVERY=manual
RESEND_API_KEY=
INVITATION_EMAIL_FROM=
# Exact comma-separated mailbox addresses, never a wildcard/domain.
INVITATION_EMAIL_ALLOWLIST=
