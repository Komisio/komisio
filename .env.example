NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key
# Required for branded seller activation: same secret as the Supabase Send Email
# HTTP hook at /api/auth/email. Configure only after deploying the handler.
KOMISIO_AUTH_EMAIL_HOOK_SECRET=
# Enable only after installing and verifying the hook; false preserves SMTP.
KOMISIO_AUTH_EMAIL_HOOK_ENABLED=false
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Optional operator-owned legal documents; unset hides legal/pricing links.
# Pages must follow {base}/{sv|en|no|dk|fi|de|es|it}/{terms|privacy|dpa|pricing}/.
KOMISIO_LEGAL_BASE_URL=
# Optional product-news email preference; independent of advertising cookies.
KOMISIO_MARKETING_CONSENT_ENABLED=false
# Optional, disabled when either value is empty. Configure only after consent,
# marketing-site attribution and the matching Google Ads action are verified.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_STORE_LABEL=
# Enable the staff receiving pilot only after applying its additive migration.
KOMISIO_INTAKE_ENABLED=false
# Preparation only: registers inactive Weblink printers; does not activate transport.
KOMISIO_WEBLINK_SETUP_ENABLED=false
# Local/pilot photo pre-review. Enable only after applying its migration.
KOMISIO_SELLER_SUBMISSIONS_ENABLED=false
# Server-only capability; its SHA-256 verifier is provisioned in the private
# seller_ai_runtime table. Local setup: node scripts/configure-local-seller-ai.mjs
KOMISIO_SELLER_AI_SERVER_KEY=
# Only needed for the database concurrency test; never exposed to the browser.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted test deployment only; do not copy TEST_DATABASE_URL to Vercel.
KOMISIO_ENVIRONMENT=staging
# Optional pilot invitation transport. Supabase Auth SMTP is configured separately.
INVITATION_EMAIL_DELIVERY=manual
RESEND_API_KEY=
INVITATION_EMAIL_FROM=
# Who outbound mail reaches: `*` for an open deployment, or exact
# comma-separated mailbox addresses for a pilot. Empty sends nothing. The
# volume per store is capped by the host in the engine, not here.
INVITATION_EMAIL_ALLOWLIST=
# Optional seller message transport (P2 S18). Falls back to the invitation settings.
SELLER_EMAIL_DELIVERY=
SELLER_EMAIL_FROM=
SELLER_EMAIL_ALLOWLIST=
# Welcome/account activation uses Supabase Auth SMTP when seller delivery is enabled.
# Set auth for Auth-only delivery, or manual to disable account creation/email.
# Otherwise inherits SELLER_EMAIL_DELIVERY / INVITATION_EMAIL_DELIVERY.
SELLER_ACCOUNT_DELIVERY=
# Optional reception assistance. Explicit allowlisted stores only; no live defaults.
# Read docs/RECEPTION-ASSISTANCE.md before supplying a separate provider key.
KOMISIO_RECEPTION_AI_PROVIDER=
KOMISIO_RECEPTION_AI_KEY=
KOMISIO_RECEPTION_AI_MODEL=
KOMISIO_RECEPTION_AI_TENANTS=

# Fortnox pilot connection (OAuth per store, tokens sealed with KOMISIO_CREDENTIAL_KEY).
# See docs/FORTNOX-CONNECTION.md. The company name pin is mandatory; the database
# number pin is set after the first check. Never pin the organisation number:
# a test company can share it with the production company.
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
FORTNOX_PILOT_TENANT_ID=
FORTNOX_EXPECTED_COMPANY_NAME=
FORTNOX_EXPECTED_DATABASE_NUMBER=
# Optional e-conomic draft exports for DKK stores; server-only app credentials.
# See docs/ECONOMIC-CONNECTION.md. Reuses the credential key below.
ECONOMIC_APP_SECRET_TOKEN=
ECONOMIC_APP_PUBLIC_TOKEN=
# 32 random bytes as 64 hex characters (openssl rand -hex 32). Rotating it makes stored tokens unreadable.
KOMISIO_CREDENTIAL_KEY=
# Dedicated verified receiver, registered by the DB operator with
# komisio_private.register_shopify_privacy_actor(user_id). Never a service role.
SHOPIFY_WEBHOOK_EMAIL=
SHOPIFY_WEBHOOK_PASSWORD=

# Billing through Stripe (hosted only; see docs/ONBOARDING-AND-PLANS.md).
# Prices and tax live in Stripe. The webhook is recorded by the automation
# identity (KOMISIO_AUTOMATION_EMAIL/PASSWORD) registered as billing actor.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# One-time price for a pack of AI credits (100 credits = 100 SEK); see docs/PRICING.md.
STRIPE_CREDITS_PRICE_ID=
STRIPE_CREDITS_PRICE_ID_NOK=
STRIPE_CREDITS_PRICE_ID_DKK=
STRIPE_CREDITS_PRICE_ID_EUR=
# One-time USD 10 price for the same 100-credit pack.
STRIPE_CREDITS_PRICE_ID_USD=
# Enable only after the Stripe Tax operator checklist and staging verification.
KOMISIO_STRIPE_AUTOMATIC_TAX=
STRIPE_WEBHOOK_SECRET=

# Vercel Cron calls the automation routes with `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# Hosted MCP connector (docs/HOSTED-MCP.md): stores connect their own AI
# assistant through OAuth at NEXT_PUBLIC_APP_URL. Off unless set to true.
KOMISIO_CONNECTORS_ENABLED=false

# Swedish external price comparisons: requires a web-search capable model.
# Set the per-search credit tariff in ore before enabling pooled-key searches.
KOMISIO_RESALE_WEB_SEARCH=false
KOMISIO_RESALE_WEB_SEARCH_ORE_PER_CALL=

# Shared PayPal POS partner-hosted app. Server-only credentials.
PAYPAL_POS_CLIENT_ID=
PAYPAL_POS_CLIENT_SECRET=

# Optional outbound events: disabled without a URL. Use only an HTTPS endpoint
# you control; tenant.created includes owner contact details. See SELF-HOSTING.
# KOMISIO_EVENTS_WEBHOOK_URL=https://events.example.com/komisio
# KOMISIO_EVENTS_WEBHOOK_SECRET=replace-with-a-long-random-shared-secret
# KOMISIO_EVENTS_WEBHOOK_TIMEOUT_MS=3000

# Public support contact, read on the server; self-hosted operators should set their own.
KOMISIO_SUPPORT_EMAIL=
# Optional absolute HTTPS support page. Default email when unset/invalid: support@komisio.com.
KOMISIO_SUPPORT_URL=
