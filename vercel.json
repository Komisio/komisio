{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "preview/**": true
    }
  },
  "regions": ["arn1"],
  "crons": [
    { "path": "/api/automation/catalog-export", "schedule": "*/5 * * * *" },
    {
      "path": "/api/automation/day-closes",
      "schedule": "45 6 * * *"
    },
    {
      "path": "/api/automation/fortnox-send",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/automation/zettle-pull",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/automation/shopify-pull",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/automation/plan-notices",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/api/automation/weekly-brief",
      "schedule": "30 5 * * 1"
    }
  ],
  "buildCommand": "node scripts/check-hosted-env.mjs && npm run build"
}
